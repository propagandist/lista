# .env という名前で compose.yaml の隣に写し、値を入れてください（導入・運用ガイド: docs/manual/admin/quickstart.md）.
# 秘密の値が入るので、ほかの人が読めない権限にしてください（例: chmod 600 .env）.
# 値の前後に空白や引用符を入れないでください.

# --- 必須 ---

# 使う版（Releases に出ている版. 例: 0.9.0）
LISTA_VERSION=

# PostgreSQL のパスワード. 初めて起動したときに DB が作られる. 後から変えるときは DB の側も ALTER ROLE で変える
DB_PASSWORD=

# 利用者が開く URL（リバースプロキシの https の URL. 末尾の / は付けない）. 通知の本文と Outlook アドインのマニフェストに入る.
# 手元で試すだけなら http://localhost:8080
LISTA_BASE_URL=

# ログインに使う OIDC のプロバイダ（docs/manual/admin/oidc.md）
#   Microsoft Entra ID の例: https://login.microsoftonline.com/<テナント ID（GUID）>/v2.0
#   Keycloak の例:           https://<ホスト>/realms/<realm>
LISTA_OIDC_ISSUER_URI=
LISTA_OIDC_CLIENT_ID=
LISTA_OIDC_CLIENT_SECRET=

# 最初の利用者のメールアドレス. 利用者が 1 人もいないときだけ、起動時にこの人を登録する
LISTA_INITIAL_ACCOUNT_EMAIL=

# --- 任意 ---

# ログインのボタンの文言（既定: ログイン）
LISTA_OIDC_LOGIN_LABEL=
# email クレームが無いとき、preferred_username をメールアドレスとして使う. Microsoft Entra ID のときだけ true
LISTA_OIDC_USERNAME_AS_EMAIL=false

# Lista を出すポート（127.0.0.1 の上. 既定: 8080）
LISTA_PORT=

# Claude API の鍵. 入れると、Outlook のメールから AI が突発タスクを下書きする（docs/manual/admin/ai.md）.
# 空なら AI を呼ばず、メールの件名と本文の先頭がそのまま入る
ANTHROPIC_API_KEY=

# ntfy（docs/manual/admin/notifications.md）. 使わないなら空のまま
#   COMPOSE_PROFILES=ntfy で、同じ compose の ntfy を起動する
COMPOSE_PROFILES=
#   Lista が送る先. 同じ compose の ntfy なら http://ntfy
LISTA_NTFY_BASE_URL=
#   利用者が購読に使う URL（リバースプロキシの https の URL）
LISTA_NTFY_PUBLIC_URL=
#   送信用のユーザー lista-publisher のアクセストークン（tk_ で始まる）
LISTA_NTFY_TOKEN=

# JVM のメモリ（既定: -Xms128m -Xmx384m -XX:+UseSerialGC）. 足りなければ -Xmx を上げる
JAVA_TOOL_OPTIONS=
